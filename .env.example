NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Avoid downloading unused legacy Puppeteer Chromium during npm ci.
PUPPETEER_SKIP_DOWNLOAD="1"
