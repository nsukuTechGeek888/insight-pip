# Use a dedicated development database, never production credentials.
DATABASE_URL="postgresql://insightpip_dev:CHANGE_ME@localhost:5432/insightpip_dev?schema=public"
# Generate separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Avoid downloading unused legacy Puppeteer Chromium during npm ci.
PUPPETEER_SKIP_DOWNLOAD="1"

# Production: use separate durable locations for public images and private evidence.
# PUBLIC_UPLOAD_DIR=/mnt/insightpip/public-uploads
# PRIVATE_STORAGE_DIR=/mnt/insightpip/private
# Set to the exact external origin, including https, behind the production proxy.
# APP_URL=https://insightpip.com
