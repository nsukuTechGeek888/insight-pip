  newsTradingWindow       String?  @map("news_trading_window")
  newsProfitCap           Int?     @map("news_profit_cap")
  newsTradingRestrictions String?  @map("news_trading_restrictions")
  profitCaps              Json?    @map("profit_caps")
  shortTradeMinDuration   Int?     @map("short_trade_min_duration")

  // ===== PROHIBITED STRATEGIES =====
  prohibitedStrategies   String[] @map("prohibited_strategies")
