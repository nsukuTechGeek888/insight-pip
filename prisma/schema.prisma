  martingaleAllowed      Boolean  @default(true) @map("martingale_allowed")
  copyTradingAllowed     Boolean  @default(true) @map("copy_trading_allowed")
  copyTradingRules       String?  @map("copy_trading_rules")
  eaTrading              Boolean  @default(true) @map("ea_trading")
  hftAllowed             Boolean  @default(true) @map("hft_allowed")
  weekendHolding         Boolean  @default(true) @map("weekend_holding")
  consistencyRule        String?  @map("consistency_rule")

  // ===== SCALING PLAN =====
  scalingPlan            Json?    @map("scaling_plan")
  
  scalingLevel1Months    Int?     @map("scaling_level1_months")
  scalingLevel1Payouts   Int?     @map("scaling_level1_payouts")
  scalingLevel1Boost     Int?     @map("scaling_level1_boost")
  scalingLevel1Split     Int?     @map("scaling_level1_split")
  scalingLevel1Drawdown  Int?     @map("scaling_level1_drawdown")
  scalingLevel1Benefits  String[] @map("scaling_level1_benefits")
  
  scalingLevel2Months        Int?     @map("scaling_level2_months")
  scalingLevel2Payouts       Int?     @map("scaling_level2_payouts")
  scalingLevel2Boost         Int?     @map("scaling_level2_boost")
  scalingLevel2Split         Int?     @map("scaling_level2_split")
  scalingLevel2Drawdown      Int?     @map("scaling_level2_drawdown")
  scalingLevel2WeeklyPayouts Boolean  @default(false) @map("scaling_level2_weekly_payouts")
  scalingLevel2Benefits      String[] @map("scaling_level2_benefits")
  
  scalingLevel3Months          Int?     @map("scaling_level3_months")
  scalingLevel3Payouts         Int?     @map("scaling_level3_payouts")
  scalingLevel3Boost           Int?     @map("scaling_level3_boost")
  scalingLevel3Split           Int?     @map("scaling_level3_split")
  scalingLevel3Drawdown        Int?     @map("scaling_level3_drawdown")
  scalingLevel3MonthlySalary   Int?     @map("scaling_level3_monthly_salary")
  scalingLevel3FreeChallenge   Boolean  @default(false) @map("scaling_level3_free_challenge")
  scalingLevel3Benefits        String[] @map("scaling_level3_benefits")
  
  scalingLevel4Months          Int?     @map("scaling_level4_months")
  scalingLevel4Payouts         Int?     @map("scaling_level4_payouts")
  scalingLevel4Boost           Int?     @map("scaling_level4_boost")
  scalingLevel4Split           Int?     @map("scaling_level4_split")
  scalingLevel4Drawdown        Int?     @map("scaling_level4_drawdown")
  scalingLevel4MonthlySalary   Int?     @map("scaling_level4_monthly_salary")
  scalingLevel4FreeChallenge   Boolean  @default(false) @map("scaling_level4_free_challenge")
  scalingLevel4Benefits        String[] @map("scaling_level4_benefits")
  scalingLevelMax              Int?     @map("scaling_level_max")

  // ===== PROMOTIONS =====
  bogoAvailable          Boolean  @default(false) @map("bogo_available")
  bogoDiscount           Int?     @map("bogo_discount")
  bogoFreeAccounts       Int?     @map("bogo_free_accounts")
  bogoFreeAccountTiming  String?  @map("bogo_free_account_timing")
  affiliateDiscountCode  String?  @map("affiliate_discount_code")
  affiliateDiscountPercent Int?   @map("affiliate_discount_percent")
  discountCodes          Json?    @map("discount_codes")

  // ===== TRADING CONDITIONS =====
  leverageOptions        Json?    @map("leverage_options")
  maxLeverage            String?  @map("max_leverage")
  averageSpreads         Json?    @map("average_spreads")
  commissions            Json?    @map("commissions")
  platformFees           Float?   @default(0) @map("platform_fees")
  minTradeSize           String?  @map("min_trade_size")
  maxTradeSize           String?  @map("max_trade_size")
  marginCall             String?  @map("margin_call")
  stopOutLevel           String?  @map("stop_out_level")
  orderExecution         String?  @map("order_execution")
  tradingHours           String?  @map("trading_hours")
  swapRates              String?  @map("swap_rates")
  commissionNotes        String?  @map("commission_notes")

  // ===== PLATFORMS & FEATURES =====
  platforms          String[] @map("platforms")
  tradingInstruments String[] @map("trading_instruments")
  features           String[] @map("features")
  chartingTools      String[] @map("charting_tools")
  
  copyTradingAvailable   Boolean @default(false) @map("copy_trading_available")
  socialTradingAvailable Boolean @default(false) @map("social_trading_available")
  vpsAvailable           Boolean @default(false) @map("vps_available")
  apiAvailable           Boolean @default(false) @map("api_available")
  economicCalendar       Boolean @default(false) @map("economic_calendar")

  // ===== PAYOUT DETAILS =====
  payoutFrequency        String?  @map("payout_frequency")
  payoutMethods          String[] @map("payout_methods")
  minimumPayout          Int?     @map("minimum_payout")
  payoutProcessingTime   String?  @map("payout_processing_time")

  // ===== RESTRICTIONS =====
  supportedCountries  String[] @map("supported_countries")
  prohibitedCountries String[] @map("prohibited_countries")
  minimumAge          Int?     @map("minimum_age")
  restrictedFeatures  String[] @map("restricted_features")
  warnings            String[] @map("warnings")

  // ===== SUPPORT & EDUCATION =====
  customerSupport    String[] @map("customer_support")
  hasEducation       Boolean  @default(false) @map("has_education")
  educationResources String[] @map("education_resources")
  communityFeatures  String[] @map("community_features")

  // ===== PAYMENT METHODS =====
  depositMethodsDetails    Json?    @map("deposit_methods_details")
  withdrawalMethodsDetails Json?    @map("withdrawal_methods_details")
  depositProcessingTime    String?  @map("deposit_processing_time")
  withdrawalProcessingTime String?  @map("withdrawal_processing_time")
  inactivityFee            String?  @map("inactivity_fee")
  accountClosurePolicy     String?  @map("account_closure_policy")

  // ===== PARTNERSHIPS =====
  partnershipPrograms       String[] @map("partnership_programs")
  ibProgramAvailable        Boolean  @default(false) @map("ib_program_available")
  affiliateProgramAvailable Boolean  @default(false) @map("affiliate_program_available")

  // ===== SECURITY =====
  securityFeatures      String[] @map("security_features")
  accountVerification   String?  @map("account_verification")
  twoFactorAuth         Boolean  @default(false) @map("two_factor_auth")
  goatGuard             Boolean  @default(false) @map("goat_guard")

  // ===== SOCIAL MEDIA =====
  socialMedia           Json?    @map("social_media")
  pressReleases         Json?    @map("press_releases")

  // ===== STATISTICS =====
  monthlySearches        Int?     @map("monthly_searches")
  monthlyTraffic         Int?     @map("monthly_traffic")
  claimedPayouts         String?  @map("claimed_payouts")
  tradersServed          Int?     @map("traders_served")
  countriesServed        Int?     @map("countries_served")

  // ===== ORIGINAL FIELDS =====
  country          String?
  years            Int?
  yearsInOperation Int?     @map("years_in_operation")
  assets           String[]
  promo            String?
  signupLink       String?  @map("signup_link")

  tradingConditions Float? @map("trading_conditions")
  customerCare      Float? @map("customer_care")
  userFriendliness  Float? @map("user_friendliness")
  payoutProcess     Float? @map("payout_process")
  totalReviews      Int?   @map("total_reviews")

  // ===== INCIDENT METRICS =====
  totalIncidents        Int @default(0) @map("total_incidents")
  incidentsLast7Days    Int @default(0) @map("incidents_last_7_days")
  incidentsLast30Days   Int @default(0) @map("incidents_last_30_days")
  withdrawalReports     Int @default(0) @map("withdrawal_reports")
  withdrawalDelays      Int @default(0) @map("withdrawal_delays")
  withdrawalConfirmed   Int @default(0) @map("withdrawal_confirmed")
  withdrawalRejected    Int @default(0) @map("withdrawal_rejected")
  executionComplaints   Int @default(0) @map("execution_complaints")
  slippageReports       Int @default(0) @map("slippage_reports")
  platformIssues        Int @default(0) @map("platform_issues")
  serverDownReports     Int @default(0) @map("server_down_reports")
  accountBansReported   Int @default(0) @map("account_bans_reported")
  ruleViolationDisputes Int @default(0) @map("rule_violation_disputes")
  resolvedIncidents     Int @default(0) @map("resolved_incidents")
  disputedIncidents     Int @default(0) @map("disputed_incidents")
  lastIncidentAt        DateTime? @map("last_incident_at")
  incidentTrends        Json? @map("incident_trends")

  // ====== REGION FIELDS - NEW ======
  regions          String[] @default(["GLOBAL"])
  restrictedRegions String[] @default([])
  regionNotes      Json?    @map("region_notes")
  regionDescriptions Json? @map("region_descriptions")
  regionPricing     Json?  @map("region_pricing")
  regionPaymentMethods Json? @map("region_payment_methods")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  lastReviewed DateTime? @map("last_reviewed")

  // ===== RELATIONS =====
  reviews      Review[]            @relation("PropFirmReviews")
  favorites    Favorite[]          @relation("PropFirmFavorites")
  promotions   PropFirmPromotion[]
  incidents    Incident[]          @relation("PropFirmIncidents")
  reviewReplies ReviewReply[]      @relation("PropFirmReviewReplies")
  programs     PropFirmProgram[]

  @@index([rating])
  @@index([payoutFrequency])
  @@index([country])
  @@index([regulated])
  @@index([avgTrustScore])
  @@index([totalIncidents])
  @@index([trustpilotRating])
  @@index([maxAccountSize])
  @@index([regions]) // NEW INDEX
  @@map("prop_firms")
}

