// prisma/schema.prisma - COMPLETE UPDATED WITH REGION FIELDS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============== ENUMS ==============

enum IncidentType {
  WITHDRAWAL_PAID
  WITHDRAWAL_DELAY
  WITHDRAWAL_REJECTED
  SLIPPAGE_ISSUES
  SPREAD_SPIKE
  EXECUTION_DELAY
  TRADE_MANIPULATION_SUSPECTED
  PLATFORM_FREEZE
  SERVER_DOWN
  LOGIN_ISSUES
  ORDER_EXECUTION_FAILURE
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  WITHDRAWAL_DENIED_AFTER_PROFIT
  RULE_VIOLATION_DISPUTE
  SUSPICIOUS_BROKER_ACTIVITY
  SCAM_WARNING
  OTHER
}

enum ResolutionStatus {
  PENDING
  RESOLVED
  CONFIRMED
  DISPUTED
}

enum TraderExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum TradingStyle {
  SCALPER
  DAY_TRADER
  SWING_TRADER
  EA_TRADER
  NEWS_TRADER
}

enum ReplyType {
  USER
  BROKER
  PROP_FIRM
  ADMIN
}

// ============== USERS ==============
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER")
  avatar    String?
  
  // REGION FIELD - NEW
  region    String?   // User's preferred/current region (SA, EU, UAE, etc.)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reviews       Review[]       @relation("UserReviews")
  helpfulVotes  HelpfulVote[]  @relation("UserHelpfulVotes")
  reviewReplies ReviewReply[]  @relation("UserReviewReplies")
  reviewReports ReviewReport[] @relation("UserReviewReports")
  favorites     Favorite[]
  comparisons   Comparison[]
  incidents     Incident[]
  blogPosts     BlogPost[]     @relation("UserBlogPosts")

  @@map("users")
}

// ============== BROKERS ==============
model Broker {
  id     Int    @id @default(autoincrement())
  name   String @unique
  slug   String @unique
  status String @default("ACTIVE")

  description      String?
  shortDescription String? @map("short_description")
  logo             String?
  founded          Int?
  headquarters     String?
  website          String
  contactEmail     String? @map("contact_email")
  contactPhone     String? @map("contact_phone")

  type           String?
  category       String?
  targetAudience String[] @map("target_audience")

  regulated   Boolean @default(false)
  regulation  Json?
  safetyScore Float?  @default(0.0) @map("safety_score")

  rating       Float? @default(0.0)
  reviewsCount Int    @default(0) @map("reviews_count")
  expertRating Float? @default(0.0) @map("expert_rating")

  avgOverallRating  Float? @default(0.0) @map("avg_overall_rating")
  avgServiceRating  Float? @default(0.0) @map("avg_service_rating")
  avgPlatformRating Float? @default(0.0) @map("avg_platform_rating")
  avgValueRating    Float? @default(0.0) @map("avg_value_rating")
  avgSupportRating  Float? @default(0.0) @map("avg_support_rating")
  
  avgWithdrawalExperience Float? @default(0.0) @map("avg_withdrawal_experience")
  avgDepositExperience    Float? @default(0.0) @map("avg_deposit_experience")
  avgCustomerSupport      Float? @default(0.0) @map("avg_customer_support")
  avgTradingExperience    Float? @default(0.0) @map("avg_trading_experience")
  avgReliability          Float? @default(0.0) @map("avg_reliability")

  avgTrustScore         Float? @default(0.0) @map("avg_trust_score")
  avgWithdrawalSuccess  Float? @default(0.0) @map("avg_withdrawal_success")
  avgExecutionQuality   Float? @default(0.0) @map("avg_execution_quality")
  recommendationRate    Float? @default(0.0) @map("recommendation_rate")
  withdrawalStats       Json? @map("withdrawal_stats")
  accountIssueStats     Json? @map("account_issue_stats")

  totalIncidents        Int @default(0) @map("total_incidents")
  incidentsLast7Days    Int @default(0) @map("incidents_last_7_days")
  incidentsLast30Days   Int @default(0) @map("incidents_last_30_days")
  withdrawalReports     Int @default(0) @map("withdrawal_reports")
  withdrawalDelays      Int @default(0) @map("withdrawal_delays")
  withdrawalConfirmed   Int @default(0) @map("withdrawal_confirmed")
  withdrawalRejected    Int @default(0) @map("withdrawal_rejected")
  executionComplaints   Int @default(0) @map("execution_complaints")
  slippageReports       Int @default(0) @map("slippage_reports")
  spreadSpikeReports    Int @default(0) @map("spread_spike_reports")
  platformIssues        Int @default(0) @map("platform_issues")
  serverDownReports     Int @default(0) @map("server_down_reports")
  accountBansReported   Int @default(0) @map("account_bans_reported")
  accountSuspensions    Int @default(0) @map("account_suspensions")
  resolvedIncidents     Int @default(0) @map("resolved_incidents")
  disputedIncidents     Int @default(0) @map("disputed_incidents")
  lastIncidentAt        DateTime? @map("last_incident_at")
  incidentTrends        Json? @map("incident_trends")

  minDeposit      Float?  @map("min_deposit")
  maxLeverage     String? @map("max_leverage")
  averageSpreads  Json?   @map("average_spreads")
  commissions     Json?
  leverageOptions Json?   @map("leverage_options")

  features    String[]
  platforms   String[]
  instruments Json?

  accountTypes   BrokerAccountType[]
  demoAccount    Boolean   @default(false) @map("demo_account")
  islamicAccount Boolean   @default(false) @map("islamic_account")

  depositMethods    String[] @map("deposit_methods")
  withdrawalMethods String[] @map("withdrawal_methods")
  withdrawalFee     String?  @map("withdrawal_fee")
  minWithdrawal     Float?   @map("min_withdrawal")

  supportLanguages    String[] @map("support_languages")
  supportAvailability String?  @map("support_availability")

  hasEducation   Boolean  @default(false) @map("has_education")
  educationTypes String[] @map("education_types")

  trustScore    Int?     @default(0) @map("trust_score")
  awards        String[]
  isRecommended Boolean  @default(false) @map("is_recommended")

  country          String?
  years            Int?
  yearsInOperation Int?    @map("years_in_operation")
  assets           String?
  promo            String?
  maxAllocation    Float?  @map("max_allocation")
  payout           Float?
  bonusOffer       String? @map("bonus_offer")
  bonus            String?
  highlight        String?
  signupLink       String? @map("signup_link")
  accountSize      Float?  @map("account_size")

  corporateAddress       String?  @map("corporate_address")
  accountCurrencies      String[] @map("account_currencies")
  regulatoryWarnings     String[] @map("regulatory_warnings")
  entityMapping          Json?    @map("entity_mapping")
  minTradeSize           String?  @map("min_trade_size")
  maxTradeSize           String?  @map("max_trade_size")
  marginCall             String?  @map("margin_call")
  stopOutLevel           String?  @map("stop_out_level")
  orderExecution         String?  @map("order_execution")
  tradingHours           String?  @map("trading_hours")
  swapRates              String?  @map("swap_rates")
  commissionNotes        String?  @map("commission_notes")
  chartingTools          String[] @map("charting_tools")
  copyTradingAvailable   Boolean  @default(false) @map("copy_trading_available")
  socialTradingAvailable Boolean  @default(false) @map("social_trading_available")
  vpsAvailable           Boolean  @default(false) @map("vps_available")
  apiAvailable           Boolean  @default(false) @map("api_available")
  economicCalendar       Boolean  @default(false) @map("economic_calendar")
  newsTrading            Boolean  @default(false) @map("news_trading")
  depositMethodsDetails  Json?    @map("deposit_methods_details")
  withdrawalMethodsDetails Json?  @map("withdrawal_methods_details")
  withdrawalProcessingTime String? @map("withdrawal_processing_time")
  depositProcessingTime  String?  @map("deposit_processing_time")
  inactivityFee          String?  @map("inactivity_fee")
  accountClosurePolicy   String?  @map("account_closure_policy")
  partnershipPrograms    String[] @map("partnership_programs")
  ibProgramAvailable     Boolean  @default(false) @map("ib_program_available")
  affiliateProgramAvailable Boolean @default(false) @map("affiliate_program_available")
  securityFeatures       String[] @map("security_features")
  accountVerification    String?  @map("account_verification")
  twoFactorAuth          Boolean  @default(false) @map("two_factor_auth")
  socialMedia            Json?    @map("social_media")
  pressReleases          Json?    @map("press_releases")
  
  maxDailyLoss           Float?   @map("max_daily_loss")
  maxLossPerTrade        Float?   @map("max_loss_per_trade")
  profitTarget           String?  @map("profit_target")
  consistencyRule        String?  @map("consistency_rule")
  scalingPlan            Json?    @map("scaling_plan")
  newsTradingRestrictions String? @map("news_trading_restrictions")
  weekendHolding         Boolean  @default(true) @map("weekend_holding")
  eaTrading              Boolean  @default(true) @map("ea_trading")
  hedgingAllowed         Boolean  @default(true) @map("hedging_allowed")
  martingaleAllowed      Boolean  @default(true) @map("martingale_allowed")
  hftAllowed             Boolean  @default(true) @map("hft_allowed")
  copyTradingRules       String?  @map("copy_trading_rules")
  maxDailyProfit         Float?   @map("max_daily_profit")
  firstPayoutSplit       Int?     @map("first_payout_split")
  secondPayoutSplit      Int?     @map("second_payout_split")
  thirdPayoutSplit       Int?     @map("third_payout_split")
  maxWithdrawableProfit  Float?   @map("max_withdrawable_profit")
  goatGuard              Boolean  @default(false) @map("goat_guard")
  activationFee          Json?    @map("activation_fee")
  
  monthlySearches        Int?     @map("monthly_searches")
  monthlyTraffic         Int?     @map("monthly_traffic")
  claimedPayouts         String?  @map("claimed_payouts")
  tradersServed          Int?     @map("traders_served")
  countriesServed        Int?     @map("countries_served")
  foundedMonth           String?  @map("founded_month")
  additionalOffice       String?  @map("additional_office")
  legalName              String?  @map("legal_name")
  companyNumber          String?  @map("company_number")
  ceo                    String?  @map("ceo")

  // ====== REGION FIELDS - NEW ======
  regions          String[] @default(["GLOBAL"])  // Which regions this broker is available in
  restrictedRegions String[] @default([])         // Regions where this broker is NOT available
  regionNotes      Json?    @map("region_notes")  // Optional region-specific notes (JSON)
  regionDescriptions Json? @map("region_descriptions") // Region-specific descriptions
  regionPricing     Json?  @map("region_pricing")      // Region-specific pricing (e.g., ZAR, USD)
  regionPaymentMethods Json? @map("region_payment_methods") // Region-specific payment methods

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  lastReviewed DateTime? @map("last_reviewed")

  reviews    Review[]          @relation("BrokerReviews")
  favorites  Favorite[]        @relation("BrokerFavorites")
  bonuses    BrokerBonus[]
  promotions BrokerPromotion[]
  incidents  Incident[]        @relation("BrokerIncidents")
  reviewReplies ReviewReply[]  @relation("BrokerReviewReplies")

  @@index([rating])
  @@index([minDeposit])
  @@index([regulated])
  @@index([country])
  @@index([avgTrustScore])
  @@index([totalIncidents])
  @@index([regions]) // NEW INDEX
  @@map("brokers")
}

// ============== PROP FIRMS ==============
model PropFirm {
  id     Int    @id @default(autoincrement())
  name   String @unique
  slug   String @unique
  status String @default("ACTIVE")

  description      String?
  shortDescription String? @map("short_description")
  logo             String?
  founded          Int?
  headquarters     String?
  website          String
  contactEmail     String? @map("contact_email")
  contactPhone     String? @map("contact_phone")

  type     String?
  category String?

  // ===== COMPANY & LEADERSHIP =====
  ceo                  String?  @map("ceo")
  ceoBio               String?  @map("ceo_bio")
  leadershipTeam       Json?    @map("leadership_team")
  legalName            String?  @map("legal_name")
  companyNumber        String?  @map("company_number")
  corporateAddress     String?  @map("corporate_address")
  additionalOffice     String?  @map("additional_office")
  registrationNumber   String?  @map("registration_number")
  registrationCountry  String?  @map("registration_country")
  entityMapping        Json?    @map("entity_mapping")
  foundedMonth         String?  @map("founded_month")
  previousHeadquarters String?  @map("previous_headquarters")
  migrationStatus      String?  @map("migration_status")

  // ===== REGULATION =====
  regulated          Boolean  @default(false)
  regulation         String?
  regulatoryBodies   String[] @map("regulatory_bodies")
  regulatoryWarnings String[] @map("regulatory_warnings")
  safetyScore        Float?   @default(0.0) @map("safety_score")

  // ===== RATINGS & REVIEWS =====
  rating          Float? @default(0.0)
  reviewsCount    Int    @default(0) @map("reviews_count")
  expertRating    Float? @default(0.0) @map("expert_rating")
  avgTrustScore   Float? @default(0.0) @map("avg_trust_score")
  recommendationRate Float? @default(0.0) @map("recommendation_rate")
  isRecommended   Boolean @default(false) @map("is_recommended")

  avgOverallRating     Float? @default(0.0) @map("avg_overall_rating")
  avgTradingConditions Float? @default(0.0) @map("avg_trading_conditions")
  avgCustomerCare      Float? @default(0.0) @map("avg_customer_care")
  avgUserFriendliness  Float? @default(0.0) @map("avg_user_friendliness")
  avgPayoutProcess     Float? @default(0.0) @map("avg_payout_process")
  avgReliability       Float? @default(0.0) @map("avg_reliability")
  avgExecutionQuality  Float? @default(0.0) @map("avg_execution_quality")

  // ===== THIRD-PARTY REVIEWS =====
  trustpilotRating     Float?  @map("trustpilot_rating")
  trustpilotReviews    Int?    @map("trustpilot_reviews")
  trustpilotUrl        String? @map("trustpilot_url")
  forexPeaceArmyRating Float?  @map("forex_peace_army_rating")
  otherReviewSites     Json?   @map("other_review_sites")

  // ===== REPUTATION & SENTIMENT =====
  positiveReviewThemes  String[] @map("positive_review_themes")
  negativeReviewThemes  String[] @map("negative_review_themes")
  supportAgents         String[] @map("support_agents")
  knownIssues           Json?    @map("known_issues")
  systemBugs            String[] @map("system_bugs")
  payoutDelaysReported  Boolean  @default(false) @map("payout_delays_reported")
  slippageReported      Boolean  @default(false) @map("slippage_reported")
  hiddenRulesReported   Boolean  @default(false) @map("hidden_rules_reported")
  retroactiveRuleChanges Boolean @default(false) @map("retroactive_rule_changes")
  withdrawalDenials     Boolean  @default(false) @map("withdrawal_denials")
  publicWarnings        Json?    @map("public_warnings")
  warningDates          DateTime[] @map("warning_dates")

  // ===== FINANCIAL PERFORMANCE =====
  totalPayoutsPaid        String?  @map("total_payouts_paid")
  totalPayoutsCurrency    String?  @map("total_payouts_currency")
  totalPayoutsVerified    Boolean  @default(false) @map("total_payouts_verified")
  payoutVerificationSource String? @map("payout_verification_source")
  totalTradersServed      Int?     @map("total_traders_served")
  monthlyTradingVolume    String?  @map("monthly_trading_volume")
  dailyTradeCount         Int?     @map("daily_trade_count")

  // ===== RISK ASSESSMENT =====
  riskLevel     String?  @map("risk_level")
  riskScore     Int?     @map("risk_score")
  riskFactors   String[] @map("risk_factors")
  recommendation String? @map("recommendation")
  redFlags      String[] @map("red_flags")
  greenFlags    String[] @map("green_flags")

  // ===== ACCOUNT & CAPITAL =====
  maxAccountSize         Int?     @map("max_account_size")
  maxAccountSizeCurrency String?  @map("max_account_size_currency")
  minAccountSize         Int?     @map("min_account_size")
  accountCurrencies      String[] @map("account_currencies")
  maxAllocation          Float?   @map("max_allocation")
  minDeposit             Float?   @map("min_deposit")

  // ===== CHALLENGE MODELS =====
  oneStepAvailable       Boolean @default(false) @map("one_step_available")
  oneStepProfitTarget    Int?    @map("one_step_profit_target")
  oneStepMaxDrawdown     Int?    @map("one_step_max_drawdown")
  oneStepDailyDrawdown   Int?    @map("one_step_daily_drawdown")
  oneStepMinDays         Int?    @map("one_step_min_days")
  oneStepMaxLossPerTrade Int?    @map("one_step_max_loss_per_trade")
  oneStepConsistency     Int?    @map("one_step_consistency")
  
  twoStepAvailable       Boolean @default(false) @map("two_step_available")
  twoStepProfitTarget1   Int?    @map("two_step_profit_target_1")
  twoStepProfitTarget2   Int?    @map("two_step_profit_target_2")
  twoStepMaxDrawdown     Int?    @map("two_step_max_drawdown")
  twoStepDailyDrawdown   Int?    @map("two_step_daily_drawdown")
  twoStepMinDays1        Int?    @map("two_step_min_days_1")
  twoStepMinDays2        Int?    @map("two_step_min_days_2")
  twoStepMaxLossPerTrade Int?    @map("two_step_max_loss_per_trade")
  twoStepConsistency     Int?    @map("two_step_consistency")
  
  instantFundingAvailable Boolean @default(false) @map("instant_funding_available")
  ifMaxDrawdown          Int?    @map("if_max_drawdown")
  ifDailyDrawdown        Int?    @map("if_daily_drawdown")
  ifMinTradingDays       Int?    @map("if_min_trading_days")
  ifMaxLossPerTrade      Int?    @map("if_max_loss_per_trade")
  ifConsistencyRule      Int?    @map("if_consistency_rule")
  ifProfitSplit          Int?    @map("if_profit_split")
  ifRewardCycle          String? @map("if_reward_cycle")
  ifTimeLimit            Json?   @map("if_time_limit")

  payLaterAvailable       Boolean  @default(false) @map("pay_later_available")
  payLaterInitialFee      Int?     @map("pay_later_initial_fee")
  payLaterActivationFee   Int?     @map("pay_later_activation_fee")
  payLaterProfitTarget    Int?     @map("pay_later_profit_target")
  payLaterMaxDrawdown     Int?     @map("pay_later_max_drawdown")
  payLaterMaxLossPerTrade Int?     @map("pay_later_max_loss_per_trade")
  payLaterConsistency     Int?     @map("pay_later_consistency")
  payLaterMaxAccounts     Int?     @map("pay_later_max_accounts")
  payLaterCountryCap      Int?     @map("pay_later_country_cap")
  payLaterAccountSizes    String[] @map("pay_later_account_sizes")

  // ===== NEWS TRADING RULES =====
