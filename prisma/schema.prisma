// ============== REVIEWS ==============
model Review {
  id String @id @default(cuid())

  title   String
  content String
  rating  Int

  pros String?
  cons String?

  experienceLevel     String? @map("experience_level")
  yearsTrading        String? @map("years_trading")
  tradingStyle        String? @map("trading_style")
  tradingEnvironment  String? @map("trading_environment")

  platformStability   Int? @map("platform_stability")
  executionQuality    Int? @map("execution_quality")
  withdrawalExperience Int? @map("withdrawal_experience")
  depositExperience   Int? @map("deposit_experience")
  customerSupport     Int? @map("customer_support")
  reliability         Int? 
  value               Int?

  withdrawalSpeed     String? @map("withdrawal_speed")
  accountIssues       String? @map("account_issues")
  wouldRecommend      String? @map("would_recommend")

  trustScore          Int? @map("trust_score")
  proofFiles          Json? @map("proof_files")

  serviceRating  Int? @map("service_rating")
  platformRating Int? @map("platform_rating")
  valueRating    Int? @map("value_rating")
  supportRating  Int? @map("support_rating")

  withdrawalExperienceLegacy Int? @map("withdrawal_experience_legacy")
  depositExperienceLegacy    Int? @map("deposit_experience_legacy")
  customerSupportLegacy      Int? @map("customer_support_legacy")
  tradingExperienceLegacy    Int? @map("trading_experience_legacy")
  reliabilityLegacy          Int? @map("reliability_legacy")

  tradingConditions Int? @map("trading_conditions")
  customerCare      Int? @map("customer_care")
  userFriendliness  Int? @map("user_friendliness")
  payoutProcess     Int? @map("payout_process")

  tradingExperienceLevel String? @map("trading_experience_level")
  yearsTradingLegacy      Int?    @map("years_trading_legacy")
  verifiedTrader         Boolean @default(false) @map("verified_trader")

  isVerified     Boolean   @default(false) @map("is_verified")
  isApproved     Boolean   @default(false) @map("is_approved")
  isFeatured     Boolean   @default(false) @map("is_featured")
  isHidden       Boolean   @default(false) @map("is_hidden")
  status         String    @default("PENDING")
  moderationNote String?   @map("moderation_note")
  moderatedBy    String?   @map("moderated_by")
  moderatedAt    DateTime? @map("moderated_at")

  helpfulCount    Int @default(0) @map("helpful_count")
  notHelpfulCount Int @default(0) @map("not_helpful_count")
  replyCount      Int @default(0) @map("reply_count")
  reportCount     Int @default(0) @map("report_count")

  retractedAt        DateTime? @map("retracted_at")
  retractionReason   String?   @map("retraction_reason")
  editedAt           DateTime? @map("edited_at")
  editedWithinWindow Boolean   @default(false) @map("edited_within_window")
  trustScoreSnapshot Int?      @map("trust_score_snapshot")
  originalContent    String?   @map("original_content")
  editHistory        Json?     @map("edit_history")

  // ====== REGION FIELD - NEW ======
  region         String?   // Region where the review was written

  userId String @map("user_id")
  user   User   @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  brokerId Int?    @map("broker_id")
  broker   Broker? @relation("BrokerReviews", fields: [brokerId], references: [id], onDelete: Cascade)

  propFirmId Int?      @map("prop_firm_id")
  propFirm   PropFirm? @relation("PropFirmReviews", fields: [propFirmId], references: [id], onDelete: Cascade)

  replies ReviewReply[]
  votes   HelpfulVote[]
  reports ReviewReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, brokerId])
  @@unique([userId, propFirmId])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@index([trustScore])
  @@index([brokerId, status])
  @@index([propFirmId, status])
  @@index([region]) // NEW INDEX
  @@map("reviews")
}

// ============== REVIEW REPLIES ==============
model ReviewReply {
  id         String   @id @default(cuid())
  content    String   @db.Text
  mediaUrls  String[] @map("media_urls")
  replyType  ReplyType @default(USER) @map("reply_type")
  replyCount Int      @default(0) @map("reply_count")

  // ====== REGION FIELD - NEW ======
  region     String?   // Region where the reply was written

  reviewId   String   @map("review_id")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId     String?  @map("user_id")
  user       User?    @relation("UserReviewReplies", fields: [userId], references: [id])

  brokerId   Int?     @map("broker_id")
  broker     Broker?  @relation("BrokerReviewReplies", fields: [brokerId], references: [id])

  propFirmId Int?     @map("prop_firm_id")
  propFirm   PropFirm? @relation("PropFirmReviewReplies", fields: [propFirmId], references: [id])

  parentReplyId String?       @map("parent_reply_id")
  parentReply   ReviewReply?  @relation("ReplyReplies", fields: [parentReplyId], references: [id])
  replies       ReviewReply[] @relation("ReplyReplies")

  isApproved Boolean @default(false) @map("is_approved")
  isHidden   Boolean @default(false) @map("is_hidden")
  moderatedBy String? @map("moderated_by")
  moderatedAt DateTime? @map("moderated_at")

  helpfulCount Int @default(0) @map("helpful_count")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([reviewId])
  @@index([userId])
  @@index([brokerId])
  @@index([propFirmId])
  @@index([parentReplyId])
  @@index([replyType])
  @@index([createdAt])
  @@index([region]) // NEW INDEX
  @@map("review_replies")
}

// ============== INCIDENTS ==============
model Incident {
  id String @id @default(cuid())

  entityType     String        @map("entity_type")
  entityId       Int           @map("entity_id")
  incidentType   IncidentType  @map("incident_type")
  title          String
  description    String        @db.Text
  incidentDate   DateTime      @map("incident_date")
  reportDate     DateTime      @default(now()) @map("report_date")

  withdrawalAmount Float?          @map("withdrawal_amount")
  withdrawalMethod String?          @map("withdrawal_method")
  resolutionStatus ResolutionStatus @default(PENDING) @map("resolution_status")

  userId           String           @map("user_id")
  userExperience   TraderExperience? @map("user_experience")
  userTradingStyle TradingStyle?     @map("user_trading_style")

  proofUrls        String[] @map("proof_urls")
  proofVerified    Boolean  @default(false) @map("proof_verified")
  confirmations    Int      @default(0)
  disputes         Int      @default(0)
  verifiedBadge    Boolean  @default(false) @map("verified_badge")

  status           String    @default("PENDING")
  moderatedBy      String?   @map("moderated_by")
  moderatedAt      DateTime? @map("moderated_at")
  moderationNote   String?   @map("moderation_note")

  followUps        Json?     @map("follow_ups")
  auditLog         Json?     @map("audit_log")
  visibility       String    @default("PUBLIC") @map("visibility")

  // ====== REGION FIELD - NEW ======
  region         String?   // Region where the incident was reported

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  brokerId   Int?      @map("broker_id")
  broker     Broker?   @relation("BrokerIncidents", fields: [brokerId], references: [id], onDelete: Cascade)
  
  propFirmId Int?      @map("prop_firm_id")
  propFirm   PropFirm? @relation("PropFirmIncidents", fields: [propFirmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, brokerId, propFirmId])
  @@index([entityType, entityId])
  @@index([incidentType])
  @@index([status])
  @@index([createdAt])
  @@index([reportDate])
  @@index([resolutionStatus])
  @@index([withdrawalAmount])
  @@index([visibility])
  @@index([region]) // NEW INDEX
  
  @@map("incidents")
}

